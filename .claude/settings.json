{
  "permissions": {
    "allow": [
      "Bash(pnpm gen:component *)",
      "Bash(pnpm check)",
      "Bash(pnpm build)",
      "Bash(pnpm exec vp check *)",
      "Bash(pnpm exec vp lint *)",
      "Bash(pnpm exec vp fmt *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-changed-file.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
